# Java reads process environment; it does not automatically load this sample.
BACAY_DB_URL=jdbc:mysql://localhost:3306/bacay_online?connectTimeout=5000&socketTimeout=10000&connectionTimeZone=UTC
BACAY_DB_USER=bacay_app
BACAY_DB_PASSWORD=replace_locally
# Direct JDBC, bounded by JDK Semaphore; connections are not pooled/reused.
BACAY_DB_MAX_CONNECTIONS=12
BACAY_DB_ACQUIRE_TIMEOUT_MS=5000
# Optional: at least 16 characters; otherwise a unique random admin password is generated.
# BACAY_ADMIN_PASSWORD=your-installation-specific-secret
# TLS is enabled by default. Distribute only server.crt to client machines.
BACAY_TLS_ENABLED=true
BACAY_TLS_DIR=data/tls
# BACAY_TLS_CERT=C:/path/to/server.crt
# BACAY_TLS_SAN=dns:game.example.com,ip:192.168.1.10
